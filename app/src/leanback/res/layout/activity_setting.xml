<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aetv_surface"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/AeTVSettingsHeading"
            android:text="@string/setting_section_sources" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/vod"
                style="@style/AeTVSettingsRow"
                android:layout_marginEnd="8dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/AeTVSettingsLabel"
                    android:text="@string/setting_source_vod" />

                <TextView
                    android:id="@+id/vodUrl"
                    style="@style/AeTVSettingsValue" />

            </LinearLayout>

            <TextView
                android:id="@+id/vodHome"
                style="@style/AeTVSettingsTool"
                android:layout_marginEnd="8dp"
                android:drawableStart="@drawable/ic_setting_home"
                android:text="@string/setting_default_site" />

            <TextView
                android:id="@+id/vodHistory"
                style="@style/AeTVSettingsTool"
                android:drawableStart="@drawable/ic_setting_history"
                android:text="@string/setting_source_history" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/live"
                style="@style/AeTVSettingsRow"
                android:layout_marginEnd="8dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/AeTVSettingsLabel"
                    android:text="@string/setting_source_live" />

                <TextView
                    android:id="@+id/liveUrl"
                    style="@style/AeTVSettingsValue" />

            </LinearLayout>

            <TextView
                android:id="@+id/liveHome"
                style="@style/AeTVSettingsTool"
                android:layout_marginEnd="8dp"
                android:drawableStart="@drawable/ic_setting_home"
                android:text="@string/setting_default_channel" />

            <TextView
                android:id="@+id/liveHistory"
                style="@style/AeTVSettingsTool"
                android:drawableStart="@drawable/ic_setting_history"
                android:text="@string/setting_source_history" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/homeSiteAction"
                style="@style/AeTVSettingsAction"
                android:layout_marginEnd="8dp"
                android:drawableStart="@drawable/ic_home_vod"
                android:text="@string/home_site" />

            <TextView
                android:id="@+id/homePushAction"
                style="@style/AeTVSettingsAction"
                android:drawableStart="@drawable/ic_home_push"
                android:text="@string/home_push" />

        </LinearLayout>

        <TextView
            style="@style/AeTVSettingsHeading"
            android:text="@string/setting_section_playback" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/player"
                style="@style/AeTVSettingsAction"
                android:layout_marginEnd="8dp"
                android:text="@string/setting_player" />

            <TextView
                android:id="@+id/danmaku"
                style="@style/AeTVSettingsAction"
                android:layout_marginEnd="8dp"
                android:text="@string/setting_danmaku" />

            <TextView
                android:id="@+id/enhance"
                style="@style/AeTVSettingsAction"
                android:text="@string/setting_enhance" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/wall"
                style="@style/AeTVSettingsRow"
                android:layout_marginEnd="8dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/AeTVSettingsLabel"
                    android:text="@string/setting_wall" />

                <TextView
                    android:id="@+id/wallUrl"
                    style="@style/AeTVSettingsValue" />

            </LinearLayout>

            <TextView
                android:id="@+id/wallDefault"
                style="@style/AeTVSettingsTool"
                android:layout_marginEnd="8dp"
                android:drawableStart="@drawable/ic_setting_home"
                android:text="@string/setting_default_wall" />

            <TextView
                android:id="@+id/wallRefresh"
                style="@style/AeTVSettingsTool"
                android:drawableStart="@drawable/ic_setting_refresh"
                android:text="@string/setting_refresh_wall" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/language"
                style="@style/AeTVSettingsRow"
                android:layout_marginEnd="8dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/AeTVSettingsLabel"
                    android:text="@string/setting_language" />

                <TextView
                    android:id="@+id/languageText"
                    style="@style/AeTVSettingsValue" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/size"
                style="@style/AeTVSettingsRow"
                android:orientation="horizontal">

                <TextView
                    style="@style/AeTVSettingsLabel"
                    android:text="@string/setting_size" />

                <TextView
                    android:id="@+id/sizeText"
                    style="@style/AeTVSettingsValue" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            style="@style/AeTVSettingsHeading"
            android:text="@string/setting_section_data" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/incognito"
                style="@style/AeTVSettingsRow"
                android:layout_marginEnd="8dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/AeTVSettingsLabel"
                    android:text="@string/setting_incognito" />

                <TextView
                    android:id="@+id/incognitoText"
                    style="@style/AeTVSettingsValue" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/doh"
                style="@style/AeTVSettingsRow"
                android:orientation="horizontal">

                <TextView
                    style="@style/AeTVSettingsLabel"
                    android:text="@string/setting_doh" />

                <TextView
                    android:id="@+id/dohText"
                    style="@style/AeTVSettingsValue" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/backup"
                style="@style/AeTVSettingsAction"
                android:layout_marginEnd="8dp"
                android:text="@string/setting_backup" />

            <TextView
                android:id="@+id/restore"
                style="@style/AeTVSettingsAction"
                android:text="@string/setting_restore" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cache"
                style="@style/AeTVSettingsRow"
                android:layout_marginEnd="8dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/AeTVSettingsLabel"
                    android:text="@string/setting_cache" />

                <TextView
                    android:id="@+id/cacheText"
                    style="@style/AeTVSettingsValue" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/version"
                style="@style/AeTVSettingsRow"
                android:orientation="horizontal">

                <TextView
                    style="@style/AeTVSettingsLabel"
                    android:text="@string/setting_about" />

                <TextView
                    android:id="@+id/versionText"
                    style="@style/AeTVSettingsValue" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
